---
// 頁尾：與 ARDGE 官網頁尾一致（2026-10-10）
const site = 'https://www.ardge.com';
const cols = [
  {
    h: '產品',
    links: [
      ['/zh/products/arx-100', 'ARX-100'],
      ['/zh/products/varx-series', 'vARX 系列'],
      ['/zh/products/arx-os', 'ARX OS'],
      ['/zh/products/arx-sovereign-ai-private-cloud', '主權私有 AI 雲'],
    ],
  },
  {
    h: '解決方案',
    links: [
      ['/zh/solutions/doclake', 'DocLake'],
      ['/zh/solutions/ai-data-preprocessing', 'AI 資料前處理'],
      ['/zh/solutions/private-intelligent-video-search', '私有影片搜尋'],
      ['/zh/solutions/knowledge-management-appliance', '知識管理'],
      ['/zh/solutions/private-ai-foundation-for-isv-partners', 'ISV 夥伴私有 AI'],
    ],
  },
  {
    h: '公司',
    links: [
      ['/zh/where-to-buy', '購買通路'],
      ['/zh#team', '關於我們'],
      ['/zh/newsroom', '最新消息'],
      ['/zh/resources', '資源中心'],
      ['/zh/contact', '聯絡我們'],
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <img class="f-logo" src={`${site}/img/common/logo/ardge-logo-white.webp`} width="280" height="65" alt="ARDGE" loading="lazy" />
        <p class="f-addr">105 台灣台北市松山區南京東路四段 130 號 12 樓之 1</p>
      </div>
      {cols.map((c) => (
        <div>
          <h4>{c.h}</h4>
          {c.links.map(([href, t]) => <a href={`${site}${href}`}>{t}</a>)}
        </div>
      ))}
    </div>

    <div class="footer-bottom">
      <div class="f-legal">
        <a href={`${site}/zh/legal/private-privacy`}>隱私權政策</a>
        <a href={`${site}/zh/legal/term-of-use-software`}>使用條款</a>
      </div>
      <span>Copyright © 2025-2026 ARDGE. 保留一切權利。</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #000;
    padding: 56px 0 28px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    margin-bottom: 40px;
  }

  .f-logo {
    height: 32px;
    width: auto;
  }

  .f-addr {
    margin: 20px 0 0;
    max-width: 20rem;
    font-size: 0.875rem;
    line-height: 1.625;
    color: oklch(70.8% 0 0);
  }

  .site-footer h4 {
    margin: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
  }

  .footer-grid a {
    display: block;
    padding: 6px 0;
    font-size: 0.875rem;
    color: oklch(70.8% 0 0);
    transition: color 0.15s;
  }

  .footer-grid a:hover,
  .f-legal a:hover {
    color: #fff;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid oklch(26.9% 0 0);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: oklch(70.8% 0 0);
  }

  .f-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
  }

  .f-legal a {
    transition: color 0.15s;
  }

  @media (min-width: 48rem) {
    .site-footer {
      padding-bottom: 36px;
    }
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
  }

  @media (min-width: 64rem) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 48px;
    }
  }
</style>
