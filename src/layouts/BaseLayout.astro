---
export interface Props {
  title?: string;
  description?: string;
}
const {
  title = '共同供應契約專區 | ARDGE',
  description = 'ARDGE 電腦軟體共同供應契約上架品項：ARX-100-OS、PreciseMD-SW、ARGENT-SW、ARX-100-OS-MA、DOC-100A-SW、DOC-100B-SW，皆為本地端部署。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.ardge.com/img/og-image.png" />
    <meta property="og:locale" content="zh_TW" />
    <link rel="icon" href="https://www.ardge.com/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Open+Sans:wght@400;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* 設計規則沿用 ardge.com（Tailwind 4 tokens，2026-10-10 擷取） */
  :root {
    --green: #80bc00;
    --green-dark: #71a500;
    --green-tint: #f3f9e6;
    --fg: oklch(20% 0.02 250);
    --fg-muted: oklch(42% 0.015 250);
    --fg-faint: oklch(55% 0.012 250);
    --line: oklch(88% 0.01 250);
    --line-soft: oklch(93% 0.008 250);
    --surface: #fafafa;
    --surface-strong: #f5f5f5;
    --ink: #0a1423;
    --on-dark: #eef2f7;
    --radius-card: 10px;
    --radius-menu: 14px;
    --maxw: 80rem;
    --navbar: 60px;
    --font-sans: 'Open Sans', system-ui, -apple-system, 'PingFang TC', 'Microsoft JhengHei',
      'Noto Sans TC', sans-serif;
    --font-heading: 'Montserrat', var(--font-sans);
    --font-mono: 'Geist Mono', ui-monospace, 'SF Mono', menlo, monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: calc(var(--navbar) + 56px);
    -webkit-text-size-adjust: 100%;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    * {
      animation-duration: 0.001ms !important;
      transition-duration: 0.001ms !important;
    }
  }

  body {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--fg);
    background: #fff;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: clip;
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: var(--font-heading);
    line-height: 1.1;
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    display: block;
  }

  .wrap {
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: 20px;
  }

  @media (min-width: 64rem) {
    .wrap {
      padding-inline: 24px;
    }
  }

  /* 官網綠色圓角按鈕 */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 12px 28px;
    border-radius: 999px;
    border: 1px solid transparent;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .btn-primary {
    background: var(--green);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--green-dark);
  }

  .btn-ghost {
    border-color: rgba(255, 255, 255, 0.35);
    color: #fff;
  }

  .btn-ghost:hover {
    border-color: #fff;
  }

  :focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
