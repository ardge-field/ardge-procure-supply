---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// 上架品項 — 資料來源 ref/BOM_20261008.xlsx（輸入欄位）；不含價格、需求規格與驗收文件草稿
const items = [
  {
    sku: 'ARX-100-OS',
    name: 'ARX 圖形化本地端私有 AI 模型管理中心',
    billing: '永久授權',
    pair: '依模型與 APP 需求確認相容套件、模型授權及依賴。',
    func: '提供 Web 圖形化 AI 模型管理與部署介面，支援 Hugging Face 等模型來源及模型安裝、下載、啟用／停用與服務狀態管理。支援 API Key 發行與管理、標準 API Endpoint 建立、AI APP 上架及啟用／停用；提供 CPU、Memory、Storage、GPU 資源監控，及 Inference、Vector DB、RAG 服務狀態、系統 Log／執行紀錄與使用者／管理者權限管理。供內部系統、AI Agent、RAG 應用串接本地端模型服務。',
  },
  {
    sku: 'PreciseMD-SW',
    name: 'PreciseMD 本地端 AI 文件資料前處理－可排程批量 PDF 轉 Markdown 檔應用服務 AI-Ready Data',
    billing: '永久授權',
    pair: '搭配 ARX-100-OS 依部署需求搭配',
    func: '提供 PDF、掃描文件及圖文資料的本地端 AI 文件解析與前處理，支援 PDF 匯入、OCR 文字辨識、內容解析及 Markdown 格式轉換。可執行大量文件批次處理及排程，提供 MD 預覽、文字選取、搜尋與複製，並保留基本標題、段落及條列結構，建立可供全文搜尋、RAG、Knowledge Base 與後續分析使用的 AI-Ready Data。適用技術文件、SOP、歷史 PDF、教材、公文、典藏、法務及機敏文件內網處理。',
  },
  {
    sku: 'ARGENT-SW',
    name: 'ARGENT 本地端私有知識 AI RAG 問答服務機器人',
    billing: '永久授權',
    pair: '搭配本地端 LLM；ARX-100-OS／PreciseMD-SW 依部署需求搭配',
    func: '將企業文件與內部資料建立為私有知識庫，透過 RAG 檢索增強技術提供全文搜尋、自然語言問答與資料摘要。支援知識庫建立、文件檢索、FAQ／客服、多輪問答、回答來源引用及知識庫範圍控制，回答可追溯至依據文件。可搭配本地端 LLM；無相關資料時依策略拒答或回覆無資料。適用企業知識庫、內部客服、技術支援、教育訓練、法規查詢、SOP 及法務／行政文件查找。',
  },
  {
    sku: 'ARX-100-OS-MA',
    name: '本地端作業系統軟體維護合約',
    billing: '訂閱制（授權 1 年）',
    pair: '—',
    func: '提供 ARX OS 年度軟體維護，包括軟體版本更新、Bug Fix、安全性修正、ARX OS 相容性維護、基本遠端技術支援、系統升級建議及原廠知識庫／技術公告。不包含客製程式、新 APP、到場服務、資料整理、模型微調、大版本功能開發、第三方軟硬體費用及未列明的額外專案服務。V1.1 定位為次年度 OS 維護，不推定首年服務內容或 PreciseMD／ARGENT 維護包含於 OS MA。',
  },
  {
    sku: 'DOC-100A-SW',
    name: 'DocLake 本地端海量文件快速搜尋檢索與智慧問答平台（20 萬頁等級）',
    billing: '訂閱制（授權 1 年）',
    pair: '包含本地端 LLM；ARX-100-OS／PreciseMD-SW 依部署需求搭配',
    func: '針對 20 萬頁等級文件資料提供本地端海量文件智慧平台，整合文件前處理、OCR／Parsing、Markdown／AI-Ready Data、Indexing、全文關鍵字搜尋、RAG、智慧問答與文件來源引用。使用者可從大量文件快速找到相關內容，並透過自然語言查詢知識與核對回答來源。適用政府機關、公文與研究典藏、金融法遵、法律文件、高科技製造、技術手冊、教育機構及大型企業機敏文件庫。',
  },
  {
    sku: 'DOC-100B-SW',
    name: 'DocLake 本地端海量文件快速搜尋檢索與智慧問答平台（50 萬頁等級）',
    billing: '訂閱制（授權 1 年）',
    pair: '包含本地端 LLM；ARX-100-OS／PreciseMD-SW 依部署需求搭配',
    func: '針對 50 萬頁等級文件資料提供本地端海量文件智慧平台，整合文件前處理、OCR／Parsing、Markdown／AI-Ready Data、Indexing、全文關鍵字搜尋、RAG、智慧問答與文件來源引用。使用者可從大量文件快速找到相關內容，並透過自然語言查詢知識與核對回答來源。適用政府機關、公文與研究典藏、金融法遵、法律文件、高科技製造、技術手冊、教育機構及大型企業機敏文件庫。',
  },
];

// 建議硬體規格 — ARDGE ARX-100 基礎版 AI 一體機（ARX-100-OS 部署環境）
const hardware = [
  ['AI 伺服主機', 'NVIDIA Blackwell (GB10) 含以上'],
  ['作業系統', 'ARX OS'],
  ['中央處理器 CPU', 'ARM v9.2-A CPU 含以上'],
  ['圖形處理器 GPU', 'NVIDIA Blackwell GPU 含以上'],
  ['記憶體 Memory', '128 GB LPDDR5x 含以上'],
  ['磁碟儲存 Storage', '1TB M.2 NVMe PCIe 4.0 SSD 含以上'],
  ['網路介面 LAN', '1 x 10 Gigabit Ethernet／1 x NVIDIA ConnectX-7 SmartNIC'],
];

const no = (i: number) => String(i + 1).padStart(2, '0');
const tabs = [
  ['supplier', '供應商資格'],
  ['items', '上架品項'],
  ['details', '品項明細'],
  ['hardware', '建議硬體規格'],
  ['procure-contact', '採購洽詢'],
];
---

<BaseLayout>
  <Header />

  <main id="top">
    <!-- 橫幅（官網購買通路頁樣式） -->
    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <p class="hero-kicker">政府採購共同供應契約</p>
        <h1>共同供應契約專區</h1>
        <p class="hero-lede">ARDGE 於電腦軟體共同供應契約上架品項共 6 項，含本地端 AI 模型管理、文件資料前處理、私有知識問答、海量文件搜尋檢索與作業系統軟體維護，皆為本地端部署。</p>
      </div>
    </section>

    <!-- 分頁列 -->
    <div class="tabbar">
      <nav class="wrap tabs" aria-label="頁面段落">
        {tabs.map(([id, t], i) => (
          <a href={`#${id}`} class:list={['tab', { active: i === 0 }]} data-tab={id}>{t}</a>
        ))}
      </nav>
    </div>

    <!-- 供應商資格 -->
    <section class="sec" id="supplier">
      <div class="wrap">
        <h2 class="sec-title">供應商資格</h2>
        <article class="card">
          <p class="card-label">共同供應契約</p>
          <h3 class="card-title">116 年第一次電腦軟體共同供應契約採購</h3>
          <dl class="rows">
            <div><dt>組別</dt><dd>人工智慧與數據應用／組別 8</dd></div>
            <div><dt>廠牌</dt><dd>ARDGE</dd></div>
            <div><dt>原廠名稱</dt><dd>ARDGE Inc.</dd></div>
            <div><dt>原廠中文名稱</dt><dd>開端智能股份有限公司</dd></div>
            <div><dt>產地</dt><dd>台灣</dd></div>
          </dl>
        </article>
      </div>
    </section>

    <!-- 上架品項總覽 -->
    <section class="sec sec-alt" id="items">
      <div class="wrap">
        <h2 class="sec-title">上架品項</h2>
        <div class="card card-flush">
          <div class="it-row it-head" role="row">
            <span>項次</span>
            <span>品項名稱</span>
            <span>料號</span>
            <span>計費方式</span>
          </div>
          {items.map((it, i) => (
            <a class="it-row" href={`#item-${i + 1}`}>
              <span class="it-no">{no(i)}</span>
              <span class="it-name">{it.name}</span>
              <span class="it-sku">{it.sku}</span>
              <span class="it-bill">{it.billing}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 品項明細 -->
    <section class="sec" id="details">
      <div class="wrap">
        <h2 class="sec-title">品項明細</h2>

        <div class="item-grid">
          {items.map((it, i) => (
            <article class="card item-card" id={`item-${i + 1}`}>
              <p class="card-label">{no(i)}　/　{it.billing}</p>
              <h3 class="item-sku">{it.sku}</h3>
              <p class="item-name">{it.name}</p>
              <h4 class="item-sub">產品功能規格</h4>
              <p class="item-func">{it.func}</p>
              <dl class="rows">
                <div><dt>須搭配軟體品項</dt><dd>{it.pair}</dd></div>
              </dl>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 建議硬體規格 -->
    <section class="sec sec-alt" id="hardware">
      <div class="wrap">
        <h2 class="sec-title">建議硬體規格</h2>
        <p class="sec-sub">適用 ARX-100-OS 部署環境</p>
        <div class="card card-flush hw">
          {hardware.map(([k, v]) => (
            <div class="hw-row">
              <span class="hw-k">{k}</span>
              <span class="hw-v">{v}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 採購洽詢（官網 ARX OS 頁底部深色區塊樣式） -->
    <section class="cta" id="procure-contact">
      <div class="wrap cta-inner">
        <h2>採購下單、規格確認或專案規劃</h2>
        <div class="cta-actions">
          <a class="btn btn-primary" href="mailto:usasales@ardge.com?subject=共同供應契約專區採購洽詢">usasales@ardge.com</a>
          <a class="btn btn-ghost" href="https://www.ardge.com/zh/contact">前往聯絡表單</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  // 分頁列：依捲動位置標示目前段落（取最後一個頂端已越過分頁列的段落）
  (() => {
    const tabs = [...document.querySelectorAll('.tab')];
    const secs = tabs.map((t) => document.getElementById(t.dataset.tab)).filter(Boolean);
    const bar = document.querySelector('.tabbar');
    const update = () => {
      const line = (bar?.getBoundingClientRect().bottom ?? 0) + 24;
      let id = secs[0]?.id;
      secs.forEach((sec) => {
        if (sec.getBoundingClientRect().top <= line) id = sec.id;
      });
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        id = secs[secs.length - 1]?.id;
      }
      tabs.forEach((t) => t.classList.toggle('active', t.dataset.tab === id));
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

<style>
  /* ---------- 橫幅 ---------- */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 12rem;
    padding-block: 48px;
    overflow: hidden;
    background: #000;
  }

  .hero-glow {
    position: absolute;
    right: -10%;
    top: -60%;
    width: 60rem;
    height: 60rem;
    background: radial-gradient(circle, color-mix(in oklab, var(--green) 18%, transparent) 0, transparent 60%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-kicker {
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--green);
  }

  .hero h1 {
    font-size: 1.875rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #fff;
  }

  .hero-lede {
    margin: 16px 0 0;
    max-width: 52ch;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
  }

  @media (min-width: 48rem) {
    .hero h1 {
      font-size: 2.25rem;
    }
  }

  @media (max-width: 47.99rem) {
    .hero {
      padding-block: 40px;
    }
  }

  /* ---------- 分頁列（官網 tabs） ---------- */
  .tabbar {
    position: sticky;
    top: var(--navbar);
    z-index: 40;
    background: #fff;
    box-shadow: inset 0 -1px 0 var(--line);
  }

  .tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tabs::-webkit-scrollbar {
    display: none;
  }

  .tab {
    flex-shrink: 0;
    padding: 12px 16px;
    border-bottom: 2px solid transparent;
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--fg-faint);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .tab:hover {
    color: var(--fg);
  }

  .tab.active {
    color: var(--green-dark);
    border-bottom-color: var(--green-dark);
  }

  @media (min-width: 48rem) {
    .tab {
      padding: 14px 24px;
      font-size: 15px;
    }
  }

  /* ---------- 區段 ---------- */
  .sec {
    padding-block: 48px;
  }

  .sec-alt {
    background: var(--surface);
  }

  @media (min-width: 64rem) {
    .sec {
      padding-block: 64px;
    }
  }

  .sec-title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-align: center;
    color: #000;
    margin-bottom: 32px;
  }

  .sec-title::after {
    content: '';
    display: block;
    width: 48px;
    height: 3px;
    margin: 16px auto 0;
    border-radius: 2px;
    background: var(--green);
  }

  .sec-sub {
    margin: -16px 0 24px;
    text-align: center;
    font-size: 0.875rem;
    color: var(--fg-faint);
  }

  @media (min-width: 48rem) {
    .sec-title {
      font-size: 1.875rem;
    }
  }

  /* ---------- 卡片（官網購買通路卡片） ---------- */
  .card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 20px;
  }

  @media (min-width: 40rem) {
    .card {
      padding: 32px;
    }
  }

  .card-flush {
    padding: 0;
    overflow: hidden;
  }

  .card-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--green-dark);
  }

  .card-title {
    margin-top: 20px;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .rows {
    margin: 18px 0 0;
    display: flex;
    flex-direction: column;
  }

  .rows > div {
    display: flex;
    gap: 14px;
    padding: 12px 0;
    border-top: 1px solid var(--line-soft);
    font-size: 15px;
  }

  .rows dt {
    flex: 0 0 112px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.7;
    color: var(--fg-faint);
  }

  .rows dd {
    margin: 0;
    min-width: 0;
    color: var(--fg);
  }

  /* ---------- 上架品項總覽 ---------- */
  .it-row {
    display: grid;
    grid-template-columns: 56px 1fr 150px 150px;
    gap: 16px;
    align-items: baseline;
    padding: 16px 24px;
    border-top: 1px solid var(--line-soft);
    font-size: 15px;
    transition: background 0.15s;
  }

  a.it-row:hover {
    background: var(--green-tint);
  }

  .it-head {
    border-top: none;
    background: var(--surface-strong);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
    padding-block: 12px;
  }

  .it-no {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--green-dark);
  }

  .it-name {
    font-weight: 600;
    color: var(--fg);
  }

  .it-sku {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: var(--fg);
  }

  .it-bill {
    font-size: 14px;
    color: var(--fg-muted);
  }

  /* ---------- 品項明細 ---------- */
  .item-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: stretch;
  }

  .item-card {
    display: flex;
    flex-direction: column;
    scroll-margin-top: calc(var(--navbar) + 64px);
  }

  .item-sku {
    margin-top: 20px;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  @media (min-width: 64rem) {
    .item-sku {
      font-size: 1.875rem;
    }
  }

  .item-name {
    margin: 8px 0 0;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--fg);
  }

  .item-sub {
    margin-top: 22px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
  }

  .item-func {
    margin: 8px 0 0;
    max-width: 72rem;
    font-size: 15px;
    line-height: 1.75;
    color: var(--fg-muted);
  }

  .item-card .rows {
    margin-top: auto;
    padding-top: 18px;
  }

  /* ---------- 硬體表 ---------- */
  .hw {
    max-width: 56rem;
    margin-inline: auto;
  }

  .hw-row {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    border-top: 1px solid var(--line-soft);
  }

  .hw-row:first-child {
    border-top: none;
  }

  .hw-k,
  .hw-v {
    padding: 14px 24px;
    font-size: 15px;
  }

  .hw-k {
    font-weight: 600;
    color: var(--fg);
    background: var(--surface);
    border-right: 1px solid var(--line-soft);
  }

  .hw-v {
    color: var(--fg-muted);
  }

  /* ---------- 採購洽詢 ---------- */
  .cta {
    background: linear-gradient(180deg, var(--ink) 0%, #000 100%);
    padding-block: 64px;
    text-align: center;
  }

  .cta h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
  }

  .cta-actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  @media (min-width: 48rem) {
    .cta h2 {
      font-size: 1.875rem;
    }
  }

  /* ---------- 響應式 ---------- */
  @media (max-width: 720px) {
    .it-row {
      grid-template-columns: 36px 1fr;
      row-gap: 2px;
      padding: 14px 18px;
    }
    .it-head {
      display: none;
    }
    .it-row:nth-child(2) {
      border-top: none;
    }
    .it-sku,
    .it-bill {
      grid-column: 2;
    }
    .rows dt {
      flex-basis: 96px;
    }
  }

  @media (max-width: 480px) {
    .hw-row {
      grid-template-columns: 1fr;
    }
    .hw-k {
      border-right: none;
      padding-bottom: 6px;
    }
    .hw-v {
      padding-top: 6px;
    }
  }
</style>
