---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// 上架品項 — 資料來源 ref/BOM_20261008.xlsx（輸入欄位）；不含價格、需求規格與驗收文件草稿
const items = [
  {
    sku: 'ARX-100-OS',
    name: 'ARX 圖形化本地端私有 AI 模型管理中心',
    billing: '永久授權',
    deliver: 'ARX-100-OS 軟體及永久授權 1 套',
    pair: '依模型與 APP 需求確認相容套件、模型授權及依賴。',
    func: '提供 Web 圖形化 AI 模型管理與部署介面，支援 Hugging Face 等模型來源及模型安裝、下載、啟用／停用與服務狀態管理。支援 API Key 發行與管理、標準 API Endpoint 建立、AI APP 上架及啟用／停用；提供 CPU、Memory、Storage、GPU 資源監控，及 Inference、Vector DB、RAG 服務狀態、系統 Log／執行紀錄與使用者／管理者權限管理。供內部系統、AI Agent、RAG 應用串接本地端模型服務。',
  },
  {
    sku: 'PreciseMD-SW',
    name: 'PreciseMD 本地端 AI 文件資料前處理－可排程批量 PDF 轉 Markdown 檔應用服務 AI-Ready Data',
    billing: '永久授權',
    deliver: 'PreciseMD-SW 軟體及永久授權 1 套',
    pair: '搭配 ARX-100-OS 依部署需求搭配',
    func: '提供 PDF、掃描文件及圖文資料的本地端 AI 文件解析與前處理，支援 PDF 匯入、OCR 文字辨識、內容解析及 Markdown 格式轉換。可執行大量文件批次處理及排程，提供 MD 預覽、文字選取、搜尋與複製，並保留基本標題、段落及條列結構，建立可供全文搜尋、RAG、Knowledge Base 與後續分析使用的 AI-Ready Data。適用技術文件、SOP、歷史 PDF、教材、公文、典藏、法務及機敏文件內網處理。',
  },
  {
    sku: 'ARGENT-SW',
    name: 'ARGENT 本地端私有知識 AI RAG 問答服務機器人',
    billing: '永久授權',
    deliver: 'ARGENT-SW 軟體及永久授權 1 套',
    pair: '搭配本地端 LLM；ARX-100-OS／PreciseMD-SW 依部署需求搭配',
    func: '將企業文件與內部資料建立為私有知識庫，透過 RAG 檢索增強技術提供全文搜尋、自然語言問答與資料摘要。支援知識庫建立、文件檢索、FAQ／客服、多輪問答、回答來源引用及知識庫範圍控制，回答可追溯至依據文件。可搭配本地端 LLM；無相關資料時依策略拒答或回覆無資料。適用企業知識庫、內部客服、技術支援、教育訓練、法規查詢、SOP 及法務／行政文件查找。',
  },
  {
    sku: 'ARX-100-OS-MA',
    name: '本地端作業系統軟體維護合約',
    billing: '訂閱制（授權 1 年）',
    deliver: 'ARX-100-OS-MA 第二年起。年度軟體維護服務 1 套／1 年；非新增 OS 永久授權',
    pair: '—',
    func: '提供 ARX OS 年度軟體維護，包括軟體版本更新、Bug Fix、安全性修正、ARX OS 相容性維護、基本遠端技術支援、系統升級建議及原廠知識庫／技術公告。不包含客製程式、新 APP、到場服務、資料整理、模型微調、大版本功能開發、第三方軟硬體費用及未列明的額外專案服務。V1.1 定位為次年度 OS 維護，不推定首年服務內容或 PreciseMD／ARGENT 維護包含於 OS MA。',
  },
  {
    sku: 'DOC-100A-SW',
    name: 'DocLake 本地端海量文件快速搜尋檢索與智慧問答平台（20 萬頁等級）',
    billing: '訂閱制（授權 1 年）',
    deliver: 'DOC-100A-SW 軟體年度訂閱 1 套／1 年（20 萬頁等級）',
    pair: '包含本地端 LLM；ARX-100-OS／PreciseMD-SW 依部署需求搭配',
    func: '針對 20 萬頁等級文件資料提供本地端海量文件智慧平台，整合文件前處理、OCR／Parsing、Markdown／AI-Ready Data、Indexing、全文關鍵字搜尋、RAG、智慧問答與文件來源引用。使用者可從大量文件快速找到相關內容，並透過自然語言查詢知識與核對回答來源。適用政府機關、公文與研究典藏、金融法遵、法律文件、高科技製造、技術手冊、教育機構及大型企業機敏文件庫。',
  },
  {
    sku: 'DOC-100B-SW',
    name: 'DocLake 本地端海量文件快速搜尋檢索與智慧問答平台（50 萬頁等級）',
    billing: '訂閱制（授權 1 年）',
    deliver: 'DOC-100B-SW 軟體年度訂閱 1 套／1 年（50 萬頁等級）',
    pair: '包含本地端 LLM；ARX-100-OS／PreciseMD-SW 依部署需求搭配',
    func: '針對 50 萬頁等級文件資料提供本地端海量文件智慧平台，整合文件前處理、OCR／Parsing、Markdown／AI-Ready Data、Indexing、全文關鍵字搜尋、RAG、智慧問答與文件來源引用。使用者可從大量文件快速找到相關內容，並透過自然語言查詢知識與核對回答來源。適用政府機關、公文與研究典藏、金融法遵、法律文件、高科技製造、技術手冊、教育機構及大型企業機敏文件庫。',
  },
];

// 六項共通條件（BOM 各列相同）
const common = [
  ['授權類別', 'SVR（伺服器）'],
  ['交貨方式', 'Lic（授權）'],
  ['作業系統', 'UNIX'],
  ['作業系統說明', '本地端部署；運行與適用環境請參照原廠產品說明相關資訊'],
  ['公有雲', '否'],
  ['最低購買數／單套授權數', '1／1'],
  ['產品單位', '套'],
];

// 建議硬體規格 — ARDGE ARX-100 基礎版 AI 一體機（ARX-100-OS 部署環境）
const hardware = [
  ['AI 伺服主機', 'NVIDIA Blackwell (GB10) 含以上'],
  ['作業系統', 'ARX OS'],
  ['中央處理器 CPU', 'ARM v9.2-A CPU 含以上'],
  ['圖形處理器 GPU', 'NVIDIA Blackwell GPU 含以上'],
  ['記憶體 Memory', '128 GB LPDDR5x 含以上'],
  ['磁碟儲存 Storage', '1TB M.2 NVMe PCIe 4.0 SSD 含以上'],
  ['網路介面 LAN', '1 x 10 Gigabit Ethernet／1 x NVIDIA ConnectX-7 SmartNIC'],
];

const no = (i: number) => String(i + 1).padStart(2, '0');
---

<BaseLayout>
  <Header />

  <main id="top">
    <!-- 標題 -->
    <section class="masthead">
      <div class="wrap">
        <p class="eyebrow">政府採購共同供應契約</p>
        <h1>共同供應契約專區</h1>
        <p class="masthead-sub">ARDGE 於電腦軟體共同供應契約上架品項共 6 項，含本地端 AI 模型管理、文件資料前處理、私有知識問答、海量文件搜尋檢索與作業系統軟體維護，皆為本地端部署。</p>
      </div>
    </section>

    <!-- 供應商資格 -->
    <section class="frames">
      <div class="wrap">
        <p class="eyebrow">供應商資格</p>
        <article class="contract-block">
          <h2>116 年第一次電腦軟體共同供應契約採購</h2>
          <dl class="contract-list">
            <div><dt>組別</dt><dd>人工智慧與數據應用／組別 8</dd></div>
            <div><dt>廠牌</dt><dd>ARDGE</dd></div>
            <div><dt>原廠名稱</dt><dd>ARDGE.COM</dd></div>
            <div><dt>原廠中文名稱</dt><dd>開端智能股份有限公司</dd></div>
            <div><dt>產地</dt><dd>台灣</dd></div>
          </dl>
        </article>
      </div>
    </section>

    <!-- 上架品項總覽 -->
    <section class="section" id="items">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">上架品項</p>
        </div>
        <div class="item-table" role="table" aria-label="上架品項總覽">
          <div class="it-row it-head" role="row">
            <span role="columnheader">項次</span>
            <span role="columnheader">品項名稱</span>
            <span role="columnheader">料號</span>
            <span role="columnheader">計費方式</span>
          </div>
          {items.map((it, i) => (
            <a class="it-row" role="row" href={`#item-${i + 1}`}>
              <span class="it-no" role="cell">{no(i)}</span>
              <span class="it-name" role="cell">{it.name}</span>
              <span class="it-sku" role="cell">{it.sku}</span>
              <span class="it-bill" role="cell">{it.billing}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 品項明細 -->
    <section class="section section-alt" id="details">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">品項明細</p>
        </div>

        <div class="common-block">
          <h3>六項共通條件</h3>
          <dl class="common-list">
            {common.map(([k, v]) => (
              <div><dt>{k}</dt><dd>{v}</dd></div>
            ))}
          </dl>
        </div>

        <div class="item-cards">
          {items.map((it, i) => (
            <article class="item-card" id={`item-${i + 1}`}>
              <header class="ic-head">
                <span class="ic-no">{no(i)}</span>
                <div>
                  <p class="ic-sku">{it.sku}</p>
                  <h3>{it.name}</h3>
                </div>
              </header>
              <p class="ic-func">{it.func}</p>
              <dl class="ic-meta">
                <div><dt>計費方式</dt><dd>{it.billing}</dd></div>
                <div><dt>交付軟體及數量</dt><dd>{it.deliver}</dd></div>
                <div><dt>須搭配軟體品項</dt><dd>{it.pair}</dd></div>
              </dl>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 建議硬體規格 -->
    <section class="section" id="hardware">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">建議硬體規格</p>
          <p class="sec-note">適用 ARX-100-OS 部署環境</p>
        </div>
        <div class="hw-table" role="table" aria-label="ARX-100 建議硬體規格">
          {hardware.map(([k, v]) => (
            <div class="hw-row" role="row">
              <span class="hw-k" role="cell">{k}</span>
              <span class="hw-v" role="cell">{v}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 採購聯絡 -->
    <section class="section section-alt contact" id="procure-contact">
      <div class="wrap contact-inner">
        <div>
          <p class="eyebrow">採購洽詢</p>
          <h2 class="sec-title">採購下單、規格確認或專案規劃</h2>
        </div>
        <div class="contact-actions">
          <a class="btn btn-primary" href="mailto:usasales@ardge.com?subject=共同供應契約專區採購洽詢">
            usasales@ardge.com
          </a>
          <a class="btn btn-outline" href="https://www.ardge.com/zh/contact">前往聯絡表單</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ---------- 標題 ---------- */
  .masthead {
    background:
      radial-gradient(900px 380px at 85% -20%, var(--green-tint), transparent 60%),
      var(--paper);
    border-bottom: 1px solid var(--line);
    padding-block: 46px 36px;
  }

  .masthead h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin: 0 0 12px;
    letter-spacing: -0.02em;
  }

  .masthead-sub {
    font-size: 1.02rem;
    color: var(--ink-soft);
    margin: 0;
    max-width: 68ch;
  }

  /* ---------- 採購契約資訊 ---------- */
  .frames {
    background: var(--paper-alt);
    border-bottom: 1px solid var(--line);
    padding-block: 32px;
  }

  .contract-block {
    background: #fff;
    border: 1px solid var(--line);
    border-left: 4px solid var(--green);
    border-radius: var(--radius);
    padding: 26px 28px;
  }

  .contract-block h2 {
    font-size: 1.2rem;
    margin: 0 0 16px;
  }

  .contract-list {
    margin: 0;
    display: grid;
    gap: 0;
    max-width: 380px;
  }

  .contract-list > div {
    display: flex;
    gap: 16px;
    padding: 9px 0;
    border-top: 1px solid var(--line);
  }

  .contract-list dt {
    color: var(--gray);
    font-size: 0.92rem;
    min-width: 100px;
  }

  .contract-list dd {
    margin: 0;
    font-weight: 700;
    font-size: 0.95rem;
  }

  /* ---------- 區段共用 ---------- */
  .section {
    padding-block: 44px;
  }

  .section-alt {
    background: var(--paper-alt);
  }

  .sec-head {
    margin-bottom: 22px;
  }

  .sec-title {
    font-size: clamp(1.5rem, 3vw, 2.05rem);
    margin: 0;
  }

  .sec-note {
    margin: 0;
    font-size: 0.92rem;
    color: var(--gray);
  }

  .sec-head .eyebrow + .sec-note {
    margin-top: -8px;
  }

  /* ---------- 上架品項總覽 ---------- */
  .item-table {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .it-row {
    display: grid;
    grid-template-columns: 56px 1fr 150px 150px;
    gap: 16px;
    align-items: baseline;
    padding: 13px 20px;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
    color: var(--ink);
  }

  a.it-row:hover {
    background: var(--green-tint);
  }

  .it-head {
    border-top: none;
    background: var(--paper-alt);
    font-size: 0.85rem;
    color: var(--gray);
    font-weight: 700;
  }

  .it-no {
    font-family: var(--font-en);
    font-weight: 700;
    color: var(--green);
  }

  .it-name {
    font-weight: 700;
  }

  .it-sku {
    font-family: var(--font-en);
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .it-bill {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  /* ---------- 品項明細 ---------- */
  .common-block {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px 24px;
    margin-bottom: 20px;
  }

  .common-block h3,
  .item-card h3 {
    font-size: 1.05rem;
    margin: 0;
  }

  .common-list {
    margin: 12px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    column-gap: 28px;
  }

  .common-list > div,
  .ic-meta > div {
    display: flex;
    gap: 14px;
    padding: 8px 0;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }

  .common-list dt,
  .ic-meta dt {
    color: var(--gray);
    min-width: 120px;
    flex-shrink: 0;
  }

  .common-list dd,
  .ic-meta dd {
    margin: 0;
    color: var(--ink);
  }

  .item-cards {
    display: grid;
    gap: 16px;
  }

  .item-card {
    background: #fff;
    border: 1px solid var(--line);
    border-left: 4px solid var(--green);
    border-radius: var(--radius);
    padding: 22px 26px;
    scroll-margin-top: 84px;
  }

  .ic-head {
    display: flex;
    gap: 16px;
    align-items: baseline;
    margin-bottom: 12px;
  }

  .ic-no {
    font-family: var(--font-en);
    font-weight: 700;
    color: var(--green);
  }

  .ic-sku {
    margin: 0 0 2px;
    font-family: var(--font-en);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--green-deep);
  }

  .ic-func {
    margin: 0 0 14px;
    font-size: 0.93rem;
    color: var(--ink-soft);
    line-height: 1.8;
  }

  .ic-meta {
    margin: 0;
  }

  /* ---------- 硬體表 ---------- */
  .hw-table {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    max-width: 760px;
  }

  .hw-row {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
  }

  .hw-row:nth-child(odd) {
    background: #fff;
  }

  .hw-row:nth-child(even) {
    background: var(--paper-alt);
  }

  .section-alt .hw-row:nth-child(odd) {
    background: #fff;
  }

  .section-alt .hw-row:nth-child(even) {
    background: #f0f2ee;
  }

  .hw-k,
  .hw-v {
    padding: 14px 20px;
    font-size: 0.93rem;
  }

  .hw-k {
    font-weight: 700;
    color: var(--ink);
    border-right: 1px solid var(--line);
  }

  .hw-v {
    color: var(--ink-soft);
  }

  .hw-note {
    font-size: 0.85rem;
    color: var(--gray);
    margin: 18px 0 0;
  }

  /* ---------- 採購聯絡 ---------- */
  .contact-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 26px;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ---------- 響應式 ---------- */
  @media (max-width: 760px) {
    .section {
      padding-block: 48px;
    }
  }

  @media (max-width: 720px) {
    .it-row {
      grid-template-columns: 36px 1fr;
      row-gap: 2px;
    }
    .it-head {
      display: none;
    }
    .it-sku,
    .it-bill {
      grid-column: 2;
    }
    .item-card {
      padding: 18px 18px;
    }
    .common-list dt,
    .ic-meta dt {
      min-width: 96px;
    }
  }

  @media (max-width: 480px) {
    .hw-row {
      grid-template-columns: 1fr;
    }
    .hw-k {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
